load('ext://deployment', 'job_yaml')

netrc = os.getenv('NETRC', '')
goproxy_args = {'GOPROXY': os.getenv('GOPROXY', '')} if netrc else {}
netrc_secret = ['id=gonetrc,src=' + netrc] if netrc else []

docker_build('integration-tests', '.', build_args=goproxy_args, secret=netrc_secret, dockerfile_contents="""
FROM golang:alpine
ARG GOPROXY=https://proxy.golang.org,direct
WORKDIR /opt/integration
COPY go.* .
RUN --mount=type=secret,id=gonetrc if [ -s /run/secrets/gonetrc ]; then export NETRC=/run/secrets/gonetrc; fi && go mod download
COPY . .
ENV GOPROXY=off
CMD ["go", "test"]
""")

job = decode_yaml(job_yaml('integration-tests', 'integration-tests', env=read_yaml('./.env.yaml'), startupProbe={'exec':{'command': ['false']}, 'failureThreshold': 30}))
job['spec']['backoffLimit'] = 0
# job['spec']['ttlSecondsAfterFinished'] = 60
print(job)
k8s_yaml(encode_yaml(job))

k8s_resource('integration-tests', labels=['conjur-service-broker'], resource_deps=['conjur-service-broker'])
